NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5191,http://127.0.0.1:5191
# Set to the parent domain only when deploying frontend and API on the same site.
# COOKIE_DOMAIN=
# Optional local dev proxy override:
# API_ORIGIN=http://127.0.0.1:4000
